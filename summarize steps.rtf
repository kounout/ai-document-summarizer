import os\
import streamlit as st\
from dotenv import load_dotenv\
import google.generativeai as genai\
\
# 1. Load the secret keys from the .env file\
load_dotenv()\
\
# 2. Configure the Gemini API using our hidden key\
api_key = os.getenv("GEMINI_API_KEY")\
genai.configure(api_key=api_key)\
\
# 3. Build the User Interface with Streamlit\
st.title("My First AI App 
\f6 \uc0\u55357 \u56960 
\f4 ")\
user_input = st.text_input("What would you like to ask Gemini?")\
\
# 4. Run the model when the button is clicked\
if st.button("Generate Answer"):\
    if user_input:\
        # Using Gemini 1.5 Flash for fast, efficient responses\
        model = genai.GenerativeModel("gemini-1.5-flash")\
        response = model.generate_content(user_input)\
        \
        # Display the output on the web page\
        st.write(response.text)\
    else:\
        st.warning("Please type a question first!")\
\cb1 \
